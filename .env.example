# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# On the host, e.g. https://yourname.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# SAM.gov Public API key: sam.gov > sign in > Account Details > Public API Key
SAM_API_KEY=
# About 10 calls a day with no role. Stop early.
SAM_DAILY_CALL_CAP=8

# Plain summaries (AI). https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Leave blank for Groq. For UIUC's Lumen, use https://lumen.ncsa.illinois.edu/v1 with a Lumen key and model.
AI_BASE_URL=
SAM_EXTRACT_URL=

# Job alert emails (optional). Leave EMAIL_HOST blank to print emails in the terminal.
# For Gmail: EMAIL_HOST=smtp.gmail.com, and make an "app password" in your Google account.
SITE_URL=http://127.0.0.1:8000
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
